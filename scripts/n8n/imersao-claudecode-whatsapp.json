        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $('Config e dados').first().json.telefone, message: `Oi, ${$('Config e dados').first().json.nome}! 📅 Amanhã, 5 de novembro, às 20h, tem a Imersão Claude Code.\n\nConfira se você já está no grupo, porque o link do Zoom será enviado lá:\n${$('Config e dados').first().json.grupo_link}\n\nDica: deixe o computador carregado e com internet estável.` }) }}",
        "options": {}
